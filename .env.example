# Required only for plain-English moves.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest

# Set an absolute path if Stockfish is not on your PATH.
STOCKFISH_PATH=stockfish
ZCHESS_ORIGINS=http://localhost:5173

# Explicit local-development server URLs. Start the Chess backend separately.
# Do not point these at an unrelated service; the CLI has no implicit localhost endpoint.
ZCHESS_SERVER_URL=http://localhost:8000
VITE_ZCHESS_SERVER_URL=http://localhost:8000
